#include <stdio.h>

int main()
{
    int n, e, i, j, k;
    int a[10][10] = {0};
    int closure[10][10] = {0};

    printf("Enter number of states: ");
    scanf("%d", &n);

    printf("Enter number of epsilon transitions: ");
    scanf("%d", &e);

    printf("Enter epsilon transitions (from to):\n");

    for(i = 0; i < e; i++)
    {
        scanf("%d %d", &j, &k);
        a[j][k] = 1;
    }

    // Initially, every state belongs to its own epsilon closure
    for(i = 0; i < n; i++)
    {
        closure[i][i] = 1;
    }

    // Add epsilon transitions
    for(i = 0; i < n; i++)
    {
        for(j = 0; j < n; j++)
        {
            if(a[i][j] == 1)
                closure[i][j] = 1;
        }
    }

    // Find transitive epsilon closure
    for(k = 0; k < n; k++)
    {
        for(i = 0; i < n; i++)
        {
            for(j = 0; j < n; j++)
            {
                if(closure[i][k] && closure[k][j])
                    closure[i][j] = 1;
            }
        }
    }

    printf("\nEpsilon Closure of all states:\n");

    for(i = 0; i < n; i++)
    {
        printf("E-Closure(q%d) = { ", i);

        for(j = 0; j < n; j++)
        {
            if(closure[i][j] == 1)
                printf("q%d ", j);
        }

        printf("}\n");
    }

    return 0;
}
